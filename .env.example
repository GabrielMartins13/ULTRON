# Copie este arquivo para .env e preencha.  (cp .env.example .env)

# Senha para abrir o Ultron no navegador. Escolha uma difícil:
# o endereço do Ultron fica acessível pela internet.
ULTRON_SENHA=troque-esta-senha

# Seu nome (o Ultron vai te chamar assim)
DONO_NOME=Gabriel

# --- Cérebro (qualquer API compatível com OpenAI) ---
# Groq, grátis: crie a chave em https://console.groq.com/keys
LLM_URL=https://api.groq.com/openai/v1
LLM_CHAVE=
LLM_MODELO=openai/gpt-oss-120b

# Alternativa grátis: Google Gemini (chave em https://aistudio.google.com/apikey)
# LLM_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_CHAVE=sua-chave-gemini
# LLM_MODELO=gemini-2.5-flash

# --- Ouvido (voz -> texto) ---
# Usa o Whisper do Groq (grátis). Se ficar vazio, usa a chave do cérebro.
# Sem nenhuma chave do Groq, o app usa o reconhecimento de voz do navegador.
STT_CHAVE=
STT_MODELO=whisper-large-v3-turbo

# --- Pesquisa na web ---
# Usa o modelo groq/compound-mini, que busca na internet. Se ficar vazio e o
# cérebro for o Groq, usa a mesma chave. Sem chave do Groq, a pesquisa fica desligada.
BUSCA_CHAVE=
BUSCA_MODELO=groq/compound-mini

# --- Voz (texto -> fala), Microsoft Edge TTS, grátis ---
# Outras vozes: pt-BR-FranciscaNeural, pt-BR-ThalitaMultilingualNeural
VOZ=pt-BR-AntonioNeural
VOZ_VELOCIDADE=-4%
# Tom da voz: negativo deixa mais grave (ex.: -14Hz), 0Hz é o normal
VOZ_TOM=-14Hz

# Cidade padrão para a previsão do tempo
CIDADE=São Paulo

# Porta do servidor
PORTA=8000

# Opcional: avisa no celular (app ntfy) o endereço novo sempre que o Ultron ligar.
# Invente um nome difícil de adivinhar, ex.: ultron-gabriel-8f3k2
NTFY_TOPICO=
